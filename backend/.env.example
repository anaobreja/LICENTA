# Backend Environment Variables Example
# Copy as .env and adjust for your environment

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway_db

# JWT Secret Key
# IMPORTANT: Generate a new secret key in production!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=True
APP_NAME="Railway Digital Identity Platform"

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# QR Token
QR_TOKEN_EXPIRY_SECONDS=120

# TOTP Window (for MFA)
TOTP_WINDOW=1

