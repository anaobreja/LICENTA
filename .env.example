# ========================================
# RAILWAY DIGITAL IDENTITY PLATFORM
# ROOT ENVIRONMENT VARIABLES EXAMPLE
# ========================================
# Copy to .env and adjust for your setup.

# ========================================
# DATABASE — PostgreSQL (singurul backend suportat)
# ========================================
# Pentru docker-compose (default), host = "postgres":
DATABASE_URL=postgresql+psycopg://railway:railway_dev@postgres:5432/railway_db

# Pentru rulare locala (python run.py) cu Postgres in docker:
# DATABASE_URL=postgresql+psycopg://railway:railway_dev@localhost:5432/railway_db

DB_USER=railway
DB_PASSWORD=railway_dev
DB_NAME=railway_db
DB_PORT=5432

# ========================================
# BACKEND API
# ========================================
API_PORT=8000
API_HOST=0.0.0.0

# ========================================
# FRONTEND
# ========================================
FRONTEND_PORT=5173

# ========================================
# JWT & SECURITY — SECRET_KEY este OBLIGATORIU
# ========================================
# Genereaza o cheie reala (min 32 caractere): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-USE-A-STRONG-SECRET-MIN-32-CHARS-LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# QR & VALIDATION
# ========================================
QR_TOKEN_EXPIRY_SECONDS=120

# ========================================
# MFA & TOTP
# ========================================
TOTP_WINDOW=1

# ========================================
# APPLICATION
# ========================================
DEBUG=True
APP_NAME=Railway Digital Identity Platform
APP_VERSION=1.0.0

# ========================================
# NOTES
# ========================================
# For production:
# 1. Change SECRET_KEY to a strong random value (see above command)
# 2. Set DEBUG=False
# 3. Use strong DB password
# 4. Use HTTPS termination at reverse proxy
